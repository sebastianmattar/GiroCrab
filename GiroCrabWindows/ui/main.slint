    callback transfer-start();
    // clipboard text -> empty transfer fields; GiroCode (EPC QR) for the current fields (#663)
    callback transfer-paste(string);
    callback transfer-girocode();

    // account / category management, About, keyboard shortcuts
    in property <[color]> palette;
    in property <string> app-version;
    in-out property <bool> about-open: false;
    // ---- Mehrere Tresore (#410) und Tresor-Synchronisation (Cloud-Ordner)
    in-out property <bool> vaults-open: false;
    in property <[string]> vault-names: ["Haupttresor"];
    in-out property <int> vault-index: 0;
    in-out property <string> vault-new-name;
    in property <string> vault-status;
    in-out property <bool> vault-sync-enabled: false;
    in-out property <string> vault-sync-folder;
    callback vault-switch(int);
    callback vault-create(string);
    callback vault-delete(int);
    callback vault-sync-toggled(bool);
    callback vault-sync-folder-changed(string);
    callback vault-sync-now();
    callback vault-copy-key();
    in-out property <bool> acct-open: false;
    in-out property <bool> acct-edit: false;
    in-out property <string> acct-name;
    in-out property <int> acct-color: -1;
    in property <bool> acct-archived: false;
    in property <bool> acct-armed: false;
    in property <string> acct-status;
    in-out property <bool> cat-open: false;
    in property <[CategoryRow]> cat-rows;
    in-out property <int> cat-selected: -1;
    in-out property <string> cat-name;
    in-out property <int> cat-color: -1;
    in-out property <bool> cat-sub: false;
    in property <bool> cat-armed: false;
    in property <string> cat-status;
    callback account-new();
    callback account-edit();
    callback account-save(string, int);
    callback account-archive();
    callback account-delete();
    callback categories-open();
    callback category-select(int);
    callback category-add(string, int, bool);
    callback category-save(string, int);
    callback category-delete();
    callback shortcut(string, bool) -> bool;
    in property <int> search-focus-tick: 0;
    public function refocus() { fs.focus(); }

    callback unlock();
    callback demo();
    callback demo-switch();
    in property <bool> demo-active: false;
    in property <bool> has-own-vault: false;
    callback select-account(int);
    callback sync();
    callback search-changed();
    callback bank-search(string);
    callback bank-add(int, string);
    callback tan-submit(string);
    callback tan-cancel();

    // PIN / TAN / PSD2 dialog; mode: "pin" | "code" | "redirect" | "push"
    in property <bool> tan-open: false;
    in property <string> tan-mode;
    in property <string> tan-title;
    in property <string> tan-message;
    in property <image> tan-image;
    in property <bool> tan-has-image: false;
    in-out property <string> tan-text;

    // Slint has no clipboard API of its own: a zero-size TextInput pastes it, the text is cleared again.
    function paste-transfer() {
        clip.text = "";
        clip.paste();
        root.transfer-paste(clip.text);
        clip.text = "";
    }
    clip := TextInput { x: 0px; y: 0px; width: 0px; height: 0px; visible: false; single-line: false; }

    fs := FocusScope {
    capture-key-pressed(event) => {
        if (root.transfer-open && event.modifiers.control && event.modifiers.shift && (event.text == "V" || event.text == "v" || event.text == "\u{16}")) { root.paste-transfer(); return accept; }
        if (root.unlocked && event.modifiers.control && event.modifiers.shift && (event.text == "P" || event.text == "p" || event.text == "\u{10}")) { root.privacy = !root.privacy; root.privacy-changed(); return accept; }
        if (root.unlocked && event.modifiers.control && (event.text == "," || event.text == ";")) { SettingsImportState.request(); return accept; }
        if (root.unlocked && !root.busy && event.modifiers.control && !event.modifiers.shift && (event.text == "e" || event.text == "\u{5}")) { SettingsImportState.request(); SettingsImportState.tab = 1; return accept; }
        if (root.shortcut(event.text, event.modifiers.control)) { return accept; }
        reject
    }
    if !unlocked: VerticalLayout {
        alignment: center;
        spacing: 14px;
        padding: 40px;
        Text { text: "GiroCrab"; font-size: 36px; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
        Text {
            text: first-run ? "Neuen Tresor anlegen. Der Schlüssel liegt in der Windows-Anmeldeinformationsverwaltung."
                            : "Tresor entsperren (Schlüssel aus der Windows-Anmeldeinformationsverwaltung).";
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 12px;
            Button { text: first-run ? "Tresor anlegen" : "Entsperren"; primary: true; clicked => { root.unlock(); } }
            Button { text: "Demo-Modus"; clicked => { root.demo(); } }
        }
        Text { text: root.message; color: Theme.negative; horizontal-alignment: center; wrap: word-wrap; }
    }

    if unlocked: VerticalLayout {
        // ---- menu bar
        Rectangle {
            height: 40px;
            background: Theme.bar;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 2px;
                MenuTitle {
                    text: "Datei"; menu-height: 192px;
                    MenuEntry { text: "Alle Konten abrufen"; hint: "Strg+R"; enabled: !root.busy; clicked => { root.sync(); } }
                    MenuEntry { text: "Neue Überweisung …"; hint: "Strg+N"; enabled: !root.busy; clicked => { root.transfer-start(); } }
                    MenuSep {}
                    MenuEntry { text: "Vorhandene Daten importieren …"; hint: "Strg+I"; enabled: !root.busy; clicked => { root.import-file(); } }
                    MenuEntry { text: "Umsätze exportieren …"; hint: "Strg+E"; enabled: !root.busy; clicked => { SettingsImportState.request(); SettingsImportState.tab = 1; } }
                    MenuSep {}
                    MenuEntry { text: "Tresor sperren"; hint: "Strg+L"; clicked => { root.lock(); } }
                }
                MenuTitle {
                    text: "Ansicht"; menu-height: 262px;
                    MenuEntry { text: "Übersicht (Alle Konten)"; clicked => { root.side-click("all"); } }
                    MenuEntry { text: "Neue Buchungen"; clicked => { root.side-click("new"); } }
                    MenuEntry { text: "Geplante Zahlungen"; clicked => { root.side-click("planned"); } }
                    MenuEntry { text: "Vermögen"; clicked => { root.side-click("wealth"); } }
                    MenuEntry { text: "Lastschriften"; clicked => { root.side-click("mandates"); } }
                    MenuEntry { text: "Dokumente"; clicked => { root.side-click("docs"); } }
                    MenuSep {}
                    MenuEntry { text: root.privacy ? "Datenschutzmodus ausschalten" : "Datenschutzmodus einschalten"; hint: "Strg+Umschalt+P"; clicked => { root.privacy = !root.privacy; root.privacy-changed(); } }
                    MenuEntry { text: root.demo-active ? "Demo-Daten beenden" : "Demo-Daten ansehen"; clicked => { root.demo-switch(); } }
                }
                MenuTitle {
                    text: "Werkzeuge"; menu-height: 256px;
                    MenuEntry { text: "Regeln …"; clicked => { root.rules-request(); } }
                    MenuEntry { text: "Tags verwalten …"; clicked => { root.tags-request(); } }
                    MenuEntry { text: "Kategorien …"; clicked => { root.categories-open(); } }
                    MenuEntry { text: "Bankverbindungen …"; clicked => { root.add-open = true; } }
                    MenuEntry { text: "Tresor wechseln / Neuer Tresor …"; clicked => { root.vaults-open = true; } }
                    MenuEntry { text: "Tresor-Synchronisation …"; clicked => { root.vaults-open = true; } }
                    MenuSep {}
                    MenuEntry { text: "Einstellungen …"; hint: "Strg+,"; clicked => { SettingsImportState.request(); SettingsImportState.tab = 3; } }
                    MenuEntry { text: "Info"; clicked => { root.about-open = true; } }
                }
                MenuTitle {
                    text: "Mehr"; menu-height: 370px;
                    MenuEntry { text: "Regeln anwenden"; enabled: !root.busy; clicked => { root.apply-rules(); } }
                    MenuEntry { text: "Kategorien"; clicked => { root.categories-open(); } }
                    MenuEntry { text: "Regeln …"; clicked => { root.rules-request(); } }
                    MenuEntry { text: "Tags …"; clicked => { root.tags-request(); } }
                    MenuEntry { text: "Gruppen …"; enabled: !root.busy; clicked => { GroupsState.request(); } }
                    MenuEntry { text: "Sachwerte …"; enabled: !root.busy; clicked => { AssetsState.request(); } }
                    MenuEntry { text: "Lastschriften …"; enabled: !root.busy; clicked => { MandatesState.request(); } }
                    MenuEntry { text: "Budgets …"; clicked => { root.budgets-request(); } }
                    MenuEntry { text: "Vorlagen …"; clicked => { root.templates-request(); } }
                    MenuEntry { text: "Wiederkehrend …"; clicked => { root.rc-request(); } }
                    MenuEntry { text: "Import & Export …"; enabled: !root.busy; clicked => { SettingsImportState.request(); } }
                    MenuEntry { text: "Tresor wechseln / Neuer Tresor …"; clicked => { root.vaults-open = true; } }
                    MenuEntry { text: "Info"; clicked => { root.about-open = true; } }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.view-mode == 0: Rectangle { width: 280px;
                search-edit := LineEdit {
                    width: 280px;
                    height: 28px;
                    placeholder-text: "Suchen";
                    text <=> root.search-text;
                    edited => { root.search-changed(); }
                }
                ChangeTrigger { width: 0px; height: 0px; tick: root.search-focus-tick; fire => { search-edit.focus(); } }
                }
                PillToggle { text: "Privatmodus"; checked <=> root.privacy; toggled => { root.privacy-changed(); } }
                GhostButton { text: "Sperren"; clicked => { root.lock(); } }
            }
        }
        // ---- project announcement banner (announcements.rs)
        if SettingsImportState.banner-title != "" && !root.demo-active: Rectangle {
            height: 30px;
            background: SettingsImportState.banner-important ? Theme.warning-bg : Theme.bar;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Text { text: SettingsImportState.banner-title; color: SettingsImportState.banner-important ? Theme.warning-text : Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Button { height: 24px; y: 3px; text: "Lesen"; clicked => { SettingsImportState.banner-show(); } }
                Button { height: 24px; y: 3px; text: "Ausblenden"; clicked => { SettingsImportState.banner-dismiss(); } }
            }
        }
        // ---- demo banner
        if root.demo-active: Rectangle {
            height: 30px;
            background: Theme.warning-bg;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                // #952: the demo vault is rebuilt on every start (open_vault).
                Text { text: "Demo-Daten – diese Buchungen sind frei erfunden. Änderungen werden beim Beenden zurückgesetzt."; color: Theme.warning-text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Button {
                    height: 24px; y: 3px;
                    text: root.has-own-vault ? "Zurück zum eigenen Tresor" : "Eigenes Konto anlegen";
                    primary: true;
                    clicked => { root.demo-switch(); }
                }
            }
        }
        HorizontalLayout {
        vertical-stretch: 1;
        // ---- sidebar
        Rectangle {
            min-width: 295px;
            max-width: 295px;
            horizontal-stretch: 0;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                ListView {
                    vertical-stretch: 1;
                    min-height: 120px;
                    for r in root.side-rows: Rectangle {
                        height: r.kind == 5 ? 68px : r.kind == 1 ? 26px : r.kind == 2 ? 22px : r.key == "all" ? 38px : r.progress >= 0 ? 40px : (r.kind == 3 && r.detail != "") ? 40px : 30px;
                        if r.kind == 5: VerticalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 6px;
                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: #EAEAEA;
                                background: #EAEAEA;
                                HorizontalLayout {
                                    padding: 2px;
                                    spacing: 0px;
                                    SegButton { text: "Gruppen"; checked: root.group-mode == 0; clicked => { root.group-mode = 0; root.side-controls-changed(); } }
                                    SegButton { text: "Banken"; checked: root.group-mode == 1; clicked => { root.group-mode = 1; root.side-controls-changed(); } }
                                    SegButton { text: "Kontoart"; checked: root.group-mode == 2; clicked => { root.group-mode = 2; root.side-controls-changed(); } }
                                }
                            }
                            Rectangle {
                                height: 28px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.control-border;
                                background: Theme.surface;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 6px;
                                    spacing: 8px;
                                    Icon { name: "search"; width: 13px; height: 13px; y: (parent.height - self.height) / 2; }
                                    TextInput {
                                        horizontal-stretch: 1;
                                        horizontal-alignment: left;
                                        text <=> root.side-query;
                                        font-size: 12px;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        edited => { root.side-controls-changed(); }
                                        Text { visible: parent.text == ""; x: 0px; width: parent.width; horizontal-alignment: left; text: "Konten filtern"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                        if r.kind != 5: SideLine {
                            r: r;
                            active: root.side-selected == r.key;
                            clicked => { root.side-click(r.key); }
                            fold => { root.side-fold(r.key); }
                            add => {
                                root.add-status = "";
                                root.bank-search("");
                                root.add-open = true;
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    spacing: 8px;
                    GhostButton {
                        horizontal-stretch: 1;
                        text: "+ Konto hinzufügen";
                        clicked => {
                            root.add-status = "";
                            root.bank-search("");
                            root.add-open = true;
                        }
                    }
                }
            }
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
        }

        // ---- main pane
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 12px;
            if root.view-mode == 0: Rectangle {
                min-height: 120px;
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding-top: 12px; padding-bottom: 12px; padding-left: 16px; padding-right: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: max(120px, bal.preferred-width);
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: root.selected-name == "" ? "Keine Konten" : root.selected-name;
                            font-size: 16px; font-weight: 700; color: Theme.text; overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if root.selected-subtitle != "": Text { text: root.selected-subtitle; color: Theme.muted; font-size: 12px; overflow: elide; vertical-alignment: center; }
                            if root.selected == 0: Rectangle {
                                vertical-stretch: 0;
                                height: 22px; width: pill-label.preferred-width + 20px; border-radius: 11px;
                                background: Theme.accent.with-alpha(root.show-liquid ? 0.22 : 0.10);
                                pill-label := Text { x: 10px; text: root.show-liquid ? "Verfügbar" : "Gesamtvermögen"; font-size: 11px; color: Theme.text; vertical-alignment: center; }
                                TouchArea { clicked => { root.show-liquid = !root.show-liquid; } }
                            }
                        }
                        bal := Text { text: (root.selected == 0 && root.show-liquid) ? root.liquid-balance : root.selected-balance; font-size: 18px; font-weight: 700; color: Theme.text; vertical-alignment: bottom; overflow: elide; wrap: no-wrap; }
                    }
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        alignment: end;
                        spacing: 8px;
                        GhostButton {
                            y: (parent.height - self.height) / 2;
                            text: "Überweisen";
                            width: 84px;
                            enabled: root.selected > 0 && !root.busy;
                            clicked => { root.transfer-start(); }
                        }
                        if root.selected > 0: GhostButton {
                            y: (parent.height - self.height) / 2;
                            text: "Einstellungen";
                            min-width: 96px;
                            enabled: !root.busy;
                            clicked => { root.account-edit(); }
                        }
                        Rectangle {
                            width: 76px;
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            opacity: root.busy ? 0.6 : 1;
                            background: sync-ta.pressed ? Theme.primary.darker(0.2) : sync-ta.has-hover ? Theme.accent : Theme.primary;
                            sync-ta := TouchArea { enabled: !root.busy; clicked => { root.sync(); } }
                            Text {
                                text: root.busy ? "…" : "Abrufen";
                                color: #ffffff; font-size: 12px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            if root.sync-status != "": Text {
                text: root.sync-status; color: Theme.muted; font-size: 11px; wrap: word-wrap;
            }
            // filter bar
            if root.view-mode == 0: HorizontalLayout {
                spacing: 8px;
                padding-right: 12px;
                horizontal-stretch: 1;
                ComboBox {
                    min-width: 110px; preferred-width: 160px; max-width: 220px; horizontal-stretch: 1;
                    model: ["Alle Umsätze", "Ungeprüft", "Geprüft", "Ausgaben", "Einnahmen"];
                    current-index <=> root.status-index;
                    selected => { root.search-changed(); }
                }
                ComboBox {
                    min-width: 110px; preferred-width: 160px; max-width: 220px; horizontal-stretch: 1;
                    model: ["Gesamter Zeitraum", "30 Tage", "90 Tage", "Dieses Jahr", "Gehaltsperiode (15.–14.)"];
                    current-index <=> root.range-index;
                    selected => { root.search-changed(); }
                }
                ComboBox {
                    min-width: 110px; preferred-width: 160px; max-width: 220px; horizontal-stretch: 1;
                    model: root.tag-labels;
                    current-index <=> root.tag-index;
                    selected => { root.search-changed(); }
                }
            }
            if root.view-mode == 0: HorizontalLayout {
                spacing: 6px;
                PillToggle {
                    text: "Ohne Kategorie";
                    checked <=> root.uncategorized-only;
                    toggled => { root.search-changed(); }
                }
                PillToggle {
                    text: "Dokumente";
                    checked <=> root.documents-only;
                    toggled => { root.search-changed(); }
                }
                PillToggle {
                    text: "Kompakt";
                    checked <=> root.compact-rows;
                }
                GhostButton { horizontal-stretch: 0; text: root.cards-open ? "Übersicht ausblenden ▴" : "Cashflow & Budgets ▾"; clicked => { root.cards-open = !root.cards-open; } }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.booking-count; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
            }
            // batch action bar (multi-select)
            if root.view-mode == 0 && root.marked-count > 0: Rectangle {
                height: 44px;
                background: Theme.accent.with-alpha(0.15);
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.18);
                HorizontalLayout {
                    padding-left: 12px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px;
                    spacing: 8px;
                    Text { text: root.marked-count + " ausgewählt"; color: Theme.text; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                    GhostButton { text: "Alle"; clicked => { root.batch-select-all(); } }
                    GhostButton { text: "Als geprüft"; clicked => { root.batch-checked(true); } }
                    GhostButton { text: "Als neu"; clicked => { root.batch-checked(false); } }
                    batch-cat := ComboBox {
                        preferred-width: 130px; min-width: 90px; horizontal-stretch: 0;
                        model: root.category-names;
                        current-index: 0;
                        selected => { root.batch-category(self.current-index); }
                    }
                    batch-tag := ComboBox {
                        preferred-width: 100px; min-width: 70px; horizontal-stretch: 0;
                        model: root.tag-labels;
                        current-index: 0;
                    }
                    GhostButton { text: "Tag +"; clicked => { root.batch-tag(batch-tag.current-index, true); } }
                    GhostButton { text: "Tag −"; clicked => { root.batch-tag(batch-tag.current-index, false); } }
                    GhostButton { text: "Regeln anwenden"; clicked => { root.apply-rules(); } }
                    GhostButton { text: "Exportieren"; clicked => { root.batch-export(); } }
                    Rectangle { horizontal-stretch: 1; }
                    GhostButton { text: "Aufheben"; clicked => { root.batch-clear(); } }
                }
            }
            // dashboard cards above the bookings: cashflow chart and budgets
            if root.view-mode == 0 && root.cards-open: CashflowCard {
                height: 190px;
                bars: root.cashflow-bars;
                ticks: root.cashflow-ticks;
                period <=> root.cashflow-period;
                changed => { root.cashflow-changed(); }
            }
            if root.view-mode == 0 && root.cards-open: Rectangle {
                height: 112px + max(root.allowance-banks.length, 1) * 20px;
                background: Theme.surface;
                border-radius: 8px;
                VerticalLayout {
                    padding: 10px; spacing: 4px;
                    Text { text: "Freistellungsaufträge & Sparer-Pauschbetrag (#616)"; font-size: 13px; font-weight: 700; color: Theme.text; overflow: elide; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.allowance-couple ? "Ehepaar (2.000 €)" : "Einzelperson (1.000 €)"; font-size: 12px; color: Theme.text; vertical-alignment: center; }
                        Switch { checked <=> root.allowance-couple; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: "Verfügbar / Nicht verteilt: " + ((root.allowance-couple ? 2000 : 1000) - root.allowance-allocated) + " €"; font-size: 12px; color: Theme.text; }
                    Text { text: root.allowance-income; font-size: 12px; color: Theme.text; overflow: elide; }
                    if root.allowance-banks.length == 0: Text { text: "Keine Freistellungsaufträge je Bank erfasst."; font-size: 12px; color: Theme.text; }
                    for b in root.allowance-banks: Text { text: b; font-size: 12px; color: Theme.text; overflow: elide; }
                }
            }
            if root.view-mode == 0 && root.cards-open: Rectangle {
                height: 84px;
                background: Theme.surface;
                border-radius: 8px;
                VerticalLayout {
                    padding: 10px; spacing: 6px;
                    Text { text: "Umsätze exportieren … (#831)"; font-size: 13px; font-weight: 700; color: Theme.text; }
                    HorizontalLayout {
                        spacing: 8px;
                        ComboBox { model: ["PDF", "CSV", "CAMT.053"]; current-index <=> root.export-format; }
                        ComboBox { model: ["Dieser Monat", "Dieses Jahr", "Alles"]; current-index <=> root.export-range; }
                        CheckBox { text: "IBAN"; checked <=> root.export-iban; enabled: root.export-format == 1; }
                        CheckBox { text: "Tags"; checked <=> root.export-tags; enabled: root.export-format == 1; }
                        GhostButton { text: "Exportieren …"; clicked => { root.export-statements(root.export-format, root.export-range, root.export-iban, root.export-tags); } }
                    }
                }
            }
            if root.view-mode == 0 && root.cards-open: Rectangle {
                height: root.budget-lines.length == 0 ? 56px : 46px + min(root.budget-lines.length, 4) * 32px;
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Text { text: root.budget-title; color: Theme.text; font-size: 14px; font-weight: 700; }
                    if root.budget-lines.length == 0: Text { text: "Keine Ausgaben in diesem Monat"; color: Theme.muted; font-size: 11px; }
                    for l[i] in root.budget-lines: BudgetBar { l: l; visible: i < 4; height: i < 4 ? 30px : 0px; }
                }
            }
            if root.view-mode == 0 && root.cards-open: Rectangle {
                height: 50px + (root.analytics-expense-cats.length + root.analytics-income-cats.length + root.analytics-tags.length) * 32px + (root.analytics-tags.length == 0 ? 20px : 0px) + 90px;
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Text { text: "Analysen"; color: Theme.text; font-size: 14px; font-weight: 700; }
                    Text { text: root.analytics-summary; color: Theme.muted; font-size: 11px; overflow: elide; }
                    Text { text: "Ausgaben nach Kategorie"; color: Theme.text; font-size: 12px; font-weight: 700; }
                    for l in root.analytics-expense-cats: BudgetBar { l: l; height: 30px; }
                    Text { text: "Einnahmen nach Kategorie"; color: Theme.text; font-size: 12px; font-weight: 700; }
                    for l in root.analytics-income-cats: BudgetBar { l: l; height: 30px; }
                    Text { text: "Auswertung nach Tags"; color: Theme.text; font-size: 12px; font-weight: 700; }
                    if root.analytics-tags.length == 0: Text { text: "Keine getaggten Buchungen im Filter"; color: Theme.muted; font-size: 11px; }
                    for l in root.analytics-tags: BudgetBar { l: l; height: 30px; }
                }
            }
            if root.view-mode == 0: Rectangle {
                vertical-stretch: 1;
                    if root.days.length == 0: Text {
                        text: (root.search-text == "" && !root.uncategorized-only && root.status-index == 0) ? "Keine Umsätze" : "Keine Treffer";
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ListView {
                        for d in root.days: VerticalLayout {
                            padding-right: 16px;
                            spacing: 6px;
                            if d.show-month: HorizontalLayout {
                                height: 34px;
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 10px;
                                Text { text: d.month; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "Einnahmen " + d.month-income; color: Theme.positive; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                                Text { text: "Ausgaben " + d.month-expense; color: Theme.muted; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                            }
                            DayCard {
                                day: d;
                                selected-booking: root.selected-booking;
                                multi-select-active: root.marked-count > 0;
                                compact: root.compact-rows;
                                select(id) => { root.select-booking(id); }
                                toggle-checked(id) => { root.toggle-booking-checked(id); }
                                toggle-mark(id) => { root.toggle-booking-mark(id); }
                            }
                        }
                    }
                }
            // ---- data pane: depot / Sachwerte, Vermögen, Geplant, Lastschriften, Belege
            if root.view-mode != 0: VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                Rectangle {
                    height: root.view-mode == 1 || root.view-mode == 2 ? 88px : 56px;
                    background: Theme.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 4px;
                            Text { text: root.view-title; font-size: root.view-mode == 1 || root.view-mode == 2 ? 16px : 18px; font-weight: 700; color: Theme.text; overflow: elide; }
                            if root.view-mode == 1 || root.view-mode == 2: Text { text: root.view-total; font-size: 24px; font-weight: 700; color: Theme.text; overflow: elide; }
                        }
                        if root.view-mode == 1: VerticalLayout {
                            alignment: center;
                            ComboBox {
                                                            width: 190px;
                                model: root.period-labels;
                                current-index <=> root.period-index;
                                selected => { root.view-changed(); }
                            }
                        }
                        if root.view-mode == 3: VerticalLayout {
                            alignment: center;
                            ComboBox {
                                                            width: 190px;
                                model: root.interval-labels;
                                current-index <=> root.interval-index;
                                selected => { root.view-changed(); }
                            }
                        }
                        if root.view-mode == 5: HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                ComboBox {
                                                                    width: 170px;
                                    model: root.doc-accounts;
                                    current-index <=> root.doc-account-index;
                                }
                            }
                            GhostButton { y: (parent.height - self.height) / 2; text: "Datei hinzufügen …"; enabled: !root.busy && root.doc-accounts.length > 0; clicked => { root.doc-attach(); } }
                        }
                    }
                }
                if root.view-note != "": Text { text: root.view-note; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                if root.view-mode == 2: HorizontalLayout {
                    spacing: 6px;
                    for label[i] in ["Alles", "Cash", "Wertpapiere", "Sachwerte"]: SegButton {
                        text: label;
                        checked: root.wealth-tab == i;
                        clicked => { root.wealth-tab = i; root.view-changed(); }
                    }
                    Rectangle { horizontal-stretch: 2; }
                }
                if root.view-mode == 1: HorizontalLayout {
                    spacing: 10px;
                    for k in root.kpis: KpiCard { k: k; }
                }
                if (root.view-mode == 1 || root.view-mode == 2) && root.shares.length > 0: Rectangle {
                    height: 44px + root.shares.length * 26px;
                    background: Theme.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 4px;
                        Text { text: "Zusammensetzung"; color: Theme.muted; font-size: 11px; font-weight: 700; }
                        for s in root.shares: ShareBarLine { s: s; }
                    }
                }
                if root.view-mode == 1: HorizontalLayout {
                    spacing: 6px;
                    SegButton { text: "Positionen"; checked: root.depot-tab == 0; clicked => { root.depot-tab = 0; root.view-changed(); } }
                    SegButton { text: "Aktivitäten"; checked: root.depot-tab == 1; clicked => { root.depot-tab = 1; root.view-changed(); } }
                    Rectangle { horizontal-stretch: 4; }
                }
                if root.view-mode == 5: HorizontalLayout {
                    spacing: 8px;
                    GhostButton { text: "Öffnen"; enabled: root.doc-selected && !root.busy; clicked => { root.doc-open(); } }
                    GhostButton { text: "Mit Umsatz verknüpfen …"; enabled: root.doc-selected && !root.busy; clicked => { root.doc-link-open(); } }
                    GhostButton { text: "Verknüpfung lösen"; enabled: root.doc-linked && !root.busy; clicked => { root.doc-unlink(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.view-status != "": Text { text: root.view-status; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    VerticalLayout {
                        TableHeader { columns: root.table-columns; }
                        Rectangle {
                            vertical-stretch: 1;
                            if root.table-rows.length == 0: Text { text: root.table-empty; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                            ListView {
                                for r[i] in root.table-rows: TableLine {
                                    data: r;
                                    clickable: root.view-mode == 5;
                                    active: root.view-mode == 5 && root.table-selected == i;
                                    clicked => { if (root.view-mode == 5) { root.table-select(i); } }
                                }
                            }
                        }
                    }
                }
            }
                }
                Rectangle {
                    width: 300px;
                    horizontal-stretch: 0;
                    if !(root.view-mode == 0 && root.has-inspector): Rectangle {
                        background: Theme.surface;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text { text: root.view-mode == 0 ? "Keine Buchung ausgewählt" : "Details zur Buchung erscheinen in der Umsatzliste"; wrap: word-wrap; color: Theme.muted.with-alpha(0.8); font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    if root.view-mode == 0 && root.has-inspector: ScrollView {
                      VerticalLayout {
                        spacing: 10px;
                        padding-right: 2px;
                        // booking header
                        Rectangle {
                            height: 150px;
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    MerchantAvatar {
                                        size: 38px;
                                        logo: root.inspector.logo;
                                        has-logo: root.inspector.has-logo;
                                        monogram: root.inspector.monogram;
                                        tint: root.inspector.tint;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: root.inspector.counterparty; font-size: 14px; font-weight: 700; color: Theme.text; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
                                        Text { text: root.inspector.subtitle; font-size: 11px; color: Theme.muted; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
                                    }
                                }
                                Text { text: root.inspector.amount; font-size: 24px; font-weight: 700; color: Theme.text; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "Buchung " + root.inspector.booking-date; font-size: 11px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                                    Text { text: "Geprüft"; font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 0; }
                                    Switch {
                                        checked <=> root.inspector-checked;
                                        enabled: !root.inspector.read-only;
                                        toggled => { root.set-checked(root.inspector-checked); }
                                    }
                                }
                            }
                        }
                        // category tiles
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 260px;
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                Text { text: "Kategorie"; font-size: 12px; font-weight: 700; color: Theme.text; }
                                cat-sv := ScrollView {
                                    vertical-stretch: 1;
                                    min-height: 180px;
                                    content-height: ceil(root.category-tiles.length / 2) * 38px;
                                    for t[i] in root.category-tiles: Rectangle {
                                        x: mod(i, 2) * ((cat-sv.visible-width - 14px) / 2);
                                        y: floor(i / 2) * 38px;
                                        width: (cat-sv.visible-width - 14px) / 2 - 4px;
                                        height: 32px;
                                        property <bool> on: root.inspector-category == t.index;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: on ? t.color : Theme.border;
                                        background: on ? t.color.with-alpha(0.2) : tile-ta.has-hover ? Theme.text.with-alpha(0.05) : transparent;
                                        tile-ta := TouchArea {
                                            enabled: !root.inspector.read-only;
                                            clicked => { root.inspector-category = t.index; root.set-category(t.index); }
                                        }
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 6px;
                                            spacing: 6px;
                                            Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; background: t.color; }
                                            Text { text: t.name; font-size: 11px; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                        }
                                    }
                                }
                                GhostButton { text: "Regeln anwenden"; enabled: !root.busy; clicked => { root.apply-rules(); } }
                            }
                        }
                        // tags and split
                        Rectangle {
                            height: 48px;
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 8px;
                                Text { text: root.inspector-tags == "" ? "Keine Tags" : root.inspector-tags; font-size: 11px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                                GhostButton { text: "Tags …"; enabled: !root.inspector.read-only; clicked => { root.tags-request(); } }
                                GhostButton { text: "Aufteilen …"; enabled: !root.inspector.read-only; clicked => { root.splits-request(); } }
                            }
                        }
                        // details
                        Rectangle {
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            height: dl.preferred-height + 24px;
                            iban-copy := TextInput { text: root.inspector.iban; width: 0px; height: 0px; visible: false; }
                            dl := VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Text { text: "Details"; font-size: 12px; font-weight: 700; color: Theme.text; }
                                if root.inspector.transfer-reason != "": Text { text: "⇄ " + root.inspector.transfer-reason; font-size: 11px; color: Theme.positive; wrap: word-wrap; }
                                if root.inspector.iban != "": HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: "IBAN: " + root.inspector.iban; font-size: 11px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                                    GhostButton { text: "Kopieren"; clicked => { iban-copy.select-all(); iban-copy.copy(); } }
                                }
                                Text { text: "Buchungsdatum: " + root.inspector.booking-date + "  ·  Wertstellung: " + root.inspector.value-date; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                if root.inspector.booking-text != "": Text { text: "Buchungsart: " + root.inspector.booking-text; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                if root.inspector.reference != "": Text { text: root.inspector.reference; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                if root.inspector.purpose != "": Text { text: "Verwendungszweck"; font-size: 11px; font-weight: 700; color: Theme.text; }
                                if root.inspector.purpose != "": Text { text: root.inspector.purpose; font-size: 11px; color: Theme.text; wrap: word-wrap; }
                            }
                        }
                        // note
                        Rectangle {
                            height: 138px;
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalLayout {
                                    Text { text: "Notiz"; font-size: 12px; font-weight: 700; color: Theme.text; horizontal-stretch: 1; }
                                    GhostButton { text: "Speichern"; enabled: !root.inspector.read-only; clicked => { root.save-note(root.note-text); } }
                                }
                                TextEdit {
                                    text <=> root.note-text;
                                    enabled: !root.inspector.read-only;
                                    vertical-stretch: 1;
                                }
                            }
                        }
                        // recurring
                        Rectangle {
                            height: 44px;
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                Text { text: "Wiederkehrend"; font-size: 12px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: root.inspector.recurring ? "Erkannt" : "Nicht erkannt"; font-size: 11px; color: root.inspector.recurring ? Theme.positive : Theme.muted; vertical-alignment: center; }
                                GhostButton { text: "Ändern …"; enabled: !root.inspector.read-only; clicked => { root.rc-request(); } }
                            }
                        }
                      }
                    }
                }
            }
        }
    }
    }

    // ---- add bank dialog (overlay)
    if add-open: Rectangle {
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: min(520px, parent.width - 32px);
            height: min(520px, parent.height - 32px);
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: "Bank / Konto hinzufügen"; font-size: 18px; font-weight: 700; color: Theme.text; }
                LineEdit {
                    placeholder-text: "Bankname oder BLZ suchen";
                    edited(t) => { root.bank-search(t); }
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-width: 1px;
                    border-color: Theme.border;
                    border-radius: 8px;
                    clip: true;
                    ListView {
                        for h[i] in root.bank-hits: Rectangle {
                            height: 48px;
                            background: root.bank-choice == i ? Theme.accent.with-alpha(0.18) : transparent;
                            TouchArea { clicked => { root.bank-choice = i; } }
                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: center;
                                Text { text: h.name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                                Text { text: h.detail; color: Theme.muted; font-size: 11px; overflow: elide; }
                            }
                        }
                    }
                }
                login := LineEdit {
                    placeholder-text: "Zugangskennung / Login (bei der Demo-Bank leer lassen)";
                }
                Text {
                    text: "PIN und TAN werden erst beim Abruf abgefragt, nur im Speicher gehalten und nie gespeichert.";
                    color: Theme.muted; font-size: 11px; wrap: word-wrap;
                }
                if root.add-status != "": Text { text: root.add-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Abbrechen"; clicked => { root.add-open = false; } }
                    Button {
                        text: root.add-busy ? "Bitte warten …" : "Hinzufügen";
                        primary: true;
                        enabled: root.bank-choice >= 0 && !root.add-busy;
                        clicked => { root.bank-add(root.bank-choice, login.text); }
                    }
                }
            }
        }
    }

    // ---- SEPA transfer dialog (overlay)
    if transfer-open: Rectangle {
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: min(480px, parent.width - 32px);
            height: tr-col.preferred-height + 4px;
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            tr-col := VerticalLayout {
                padding: 18px;
                spacing: 8px;
                Text { text: "Überweisung"; font-size: 18px; font-weight: 700; color: Theme.text; }
                Text { text: "Von Konto"; font-size: 11px; color: Theme.muted; }
                tr-account := ComboBox { model: root.transfer-accounts; current-index: 0; }
                tr-name := LineEdit { text <=> root.transfer-pre-name; edited => { root.girocode-open = false; } placeholder-text: "Empfänger (Name)"; }
                tr-iban := LineEdit { text <=> root.transfer-pre-iban; edited => { root.girocode-open = false; } placeholder-text: "IBAN des Empfängers"; }
                tr-amount := LineEdit { text <=> root.transfer-pre-amount; edited => { root.girocode-open = false; } placeholder-text: "Betrag in EUR, z. B. 12,50"; }
                tr-purpose := LineEdit { text <=> root.transfer-pre-purpose; edited => { root.girocode-open = false; } placeholder-text: "Verwendungszweck (max. 140 Zeichen)"; }
                HorizontalLayout {
                    alignment: start;
                    Button { text: "Aus Zwischenablage einfügen"; clicked => { root.paste-transfer(); } }
                }
                tr-instant := Switch { text: "Echtzeitüberweisung (sofort, rund um die Uhr)"; checked: false; }
                tr-date := LineEdit {
                    placeholder-text: "Ausführungstermin TT.MM.JJJJ (leer = sofort)";
                    enabled: !tr-instant.checked;
                }
                if root.demo-active: Text {
                    text: "Demo: Die Überweisung wird nur simuliert und nicht an eine Bank gesendet.";
                    color: #2563eb; font-size: 11px; wrap: word-wrap;
                }
                Text {
                    text: "PIN und TAN werden erst beim Senden abgefragt und nie gespeichert.";
                    color: Theme.muted; font-size: 11px; wrap: word-wrap;
                }
                if root.transfer-status != "": Text { text: root.transfer-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
                if root.girocode-open: VerticalLayout {
                    spacing: 6px;
                    Rectangle {
                        height: 232px;
                        background: #ffffff;
                        Image { source: root.girocode-image; image-fit: contain; image-rendering: pixelated; width: parent.width - 8px; height: parent.height - 8px; }
                    }
                    Text {
                        text: "Scannen Sie den Code mit der App Ihrer Bank. Ausführungsdatum und Echtzeitüberweisung wählen Sie dort.";
                        color: Theme.muted; font-size: 11px; wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Abbrechen"; clicked => { root.transfer-open = false; } }
                    Button { text: "Als GiroCode anzeigen"; clicked => { root.transfer-girocode(); } }
                    Button {
                        text: "Senden";
                        primary: true;
                        clicked => { root.transfer-submit(tr-account.current-index, tr-name.text, tr-iban.text, tr-amount.text, tr-purpose.text, tr-instant.checked, tr-instant.checked ? "" : tr-date.text); }
                    }
                }
            }
        }
    }

    // ---- PIN / TAN dialog (overlay); the input is cleared as soon as it is handed over
    if tan-open: Rectangle {
        background: #000000aa;
        TouchArea { }
        Rectangle {
            width: min(460px, parent.width - 32px);
            height: tan-col.preferred-height + 4px;
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            tan-col := VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text { text: root.tan-title; font-size: 18px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
                Text { text: root.tan-message; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                if root.tan-has-image: Image { source: root.tan-image; height: 200px; image-fit: contain; }
                if root.tan-mode == "push": Text {
                    text: "Warte auf Freigabe in der Bank-App …";
                    color: Theme.text; font-size: 13px; horizontal-alignment: center;
                }
                if root.tan-mode != "push" && root.tan-mode != "confirm": LineEdit {
                    text <=> root.tan-text;
                    input-type: root.tan-mode == "pin" ? InputType.password : InputType.text;
                    placeholder-text: root.tan-mode == "pin" ? "PIN" : root.tan-mode == "redirect" ? "Adresse oder Code aus dem Browser einfügen" : "TAN";
                    accepted(t) => { root.tan-submit(t); root.tan-text = ""; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Abbrechen"; clicked => { root.tan-text = ""; root.tan-cancel(); } }
                    if root.tan-mode != "push": Button {
                        text: root.tan-mode == "confirm" ? "Trotzdem senden" : "Weiter";
                        primary: true;
                        clicked => { root.tan-submit(root.tan-text); root.tan-text = ""; }
                    }
                }
            }
        }
    }

    // ---- account dialog: create / edit / archive / delete
    if acct-open: Dialog {
        dialog-width: 460px;
        Text { text: root.acct-edit ? "Konto bearbeiten" : "Neues Konto"; font-size: 18px; font-weight: 700; color: Theme.text; }
        if !root.acct-edit: Text {
            text: "Ein Konto ohne Bankanbindung, z. B. Bargeld oder Sachwerte. Umsätze lassen sich per Import ergänzen.";
            color: Theme.muted; font-size: 11px; wrap: word-wrap;
        }
        LineEdit {
            placeholder-text: "Kontoname";
            text <=> root.acct-name;
            accepted => { root.account-save(root.acct-name, root.acct-color); }
        }
        Text { text: "Farbe"; font-size: 11px; color: Theme.muted; }
        Swatches { colors: root.palette; choice <=> root.acct-color; }
        if root.acct-status != "": Text { text: root.acct-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
        if root.acct-edit: Text {
            text: root.acct-archived ? "Archiviert: wird beim Abruf übersprungen und zählt nicht zur Summe. Löschen entfernt Umsätze, Belege und Bestände endgültig."
                                     : "Archivieren behält alle Umsätze, stoppt aber den Abruf. Gelöscht werden kann nur ein archiviertes Konto.";
            color: Theme.muted; font-size: 11px; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            if root.acct-edit: Button { text: root.acct-archived ? "Reaktivieren" : "Archivieren"; clicked => { root.account-archive(); } }
            if root.acct-edit && root.acct-archived: Button { text: root.acct-armed ? "Wirklich löschen?" : "Löschen"; clicked => { root.account-delete(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Abbrechen"; clicked => { root.acct-open = false; root.refocus(); } }
            Button { text: "Speichern"; primary: true; clicked => { root.account-save(root.acct-name, root.acct-color); } }
        }
    }

    // ---- category dialog: create / rename / recolour / delete
    if cat-open: Dialog {
        dialog-width: 560px;
        Text { text: "Kategorien"; font-size: 18px; font-weight: 700; color: Theme.text; }
        Rectangle {
            height: 220px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            clip: true;
            if root.cat-rows.length == 0: Text { text: "Noch keine Kategorien"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
            ListView {
                for r[i] in root.cat-rows: Rectangle {
                    height: 32px;
                    background: root.cat-selected == i ? Theme.accent.with-alpha(0.18) : transparent;
                    TouchArea { clicked => { root.category-select(i); } }
                    HorizontalLayout {
                        padding-left: 12px + r.depth * 18px;
                        padding-right: 12px;
                        spacing: 8px;
                        VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: r.color; } }
                        Text { text: r.name; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
        }
        LineEdit { placeholder-text: "Name der Kategorie"; text <=> root.cat-name; }
        Text { text: "Farbe"; font-size: 11px; color: Theme.muted; }
        Swatches { colors: root.palette; choice <=> root.cat-color; }
        CheckBox { text: "Neue Kategorie als Unterkategorie der Auswahl anlegen"; checked <=> root.cat-sub; enabled: root.cat-selected >= 0; }
        if root.cat-status != "": Text { text: root.cat-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
        Text {
            text: "Löschen entfernt auch Unterkategorien und deren Regeln; die Umsätze bleiben, werden aber unkategorisiert.";
            color: Theme.muted; font-size: 11px; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Neu anlegen"; clicked => { root.category-add(root.cat-name, root.cat-color, root.cat-sub); } }
            Button { text: "Speichern"; enabled: root.cat-selected >= 0; clicked => { root.category-save(root.cat-name, root.cat-color); } }
            Button { text: root.cat-armed ? "Wirklich löschen?" : "Löschen"; enabled: root.cat-selected >= 0; clicked => { root.category-delete(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Schließen"; primary: true; clicked => { root.cat-open = false; root.refocus(); } }
        }
    }

    // ---- rules dialog: create / edit / delete auto-categorisation rules
    if rules-open: Dialog {
        dialog-width: 640px;
        Text { text: "Regeln"; font-size: 18px; font-weight: 700; color: Theme.text; }
        Text { text: "Eine Regel ordnet passende Umsätze einer Kategorie zu. Angewendet wird sie mit „Regeln anwenden“."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        Rectangle {
            height: 190px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            clip: true;
            if root.rule-items.length == 0: Text { text: "Noch keine Regeln"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
            ListView {
                for r[i] in root.rule-items: Rectangle {
                    height: 44px;
                    background: root.rule-selected == i ? Theme.accent.with-alpha(0.18) : transparent;
                    TouchArea { clicked => { root.rule-select(i); } }
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;
                        spacing: 2px;
                        Text { text: r.title; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { text: r.detail; color: Theme.muted; font-size: 11px; overflow: elide; }
                    }
                }
            }
        }
        LineEdit { placeholder-text: "Name (optional)"; text <=> root.rule-name; }
        LineEdit { placeholder-text: "Suchmuster, z. B. REWE|EDEKA"; text <=> root.rule-pattern; }
        Text { text: "Kategorie"; font-size: 11px; color: Theme.muted; }
        ComboBox { model: root.rule-category-names; current-index <=> root.rule-category; }
        HorizontalLayout {
            spacing: 8px;
            ComboBox { horizontal-stretch: 1; model: root.rule-field-labels; current-index <=> root.rule-field; }
            ComboBox { horizontal-stretch: 1; model: root.rule-kind-labels; current-index <=> root.rule-kind; }
        }
        HorizontalLayout {
            spacing: 8px;
            LineEdit { horizontal-stretch: 1; placeholder-text: "Betrag ab (€, z. B. -50)"; text <=> root.rule-min; }
            LineEdit { horizontal-stretch: 1; placeholder-text: "Betrag bis (€)"; text <=> root.rule-max; }
        }
        HorizontalLayout {
            spacing: 16px;
            CheckBox { text: "Regel aktiv"; checked <=> root.rule-enabled; }
            CheckBox { text: "Groß-/Kleinschreibung beachten"; checked <=> root.rule-case; }
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Vorschau"; clicked => { root.rule-preview-request(); } }
            Button { text: "Auf unkategorisierte Treffer anwenden"; clicked => { root.rule-apply-scoped(); } }
        }
        if root.rule-preview != "": Text { text: root.rule-preview; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        if root.rule-status != "": Text { text: root.rule-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Neue Regel"; clicked => { root.rule-new(); } }
            Button { text: root.rule-selected >= 0 ? "Speichern" : "Anlegen"; primary: true; clicked => { root.rule-save(root.rule-name, root.rule-pattern, root.rule-category, root.rule-field, root.rule-kind, root.rule-enabled); } }
            Button { text: root.rule-armed ? "Wirklich löschen?" : "Löschen"; enabled: root.rule-selected >= 0; clicked => { root.rule-delete(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Schließen"; clicked => { root.rules-open = false; root.refocus(); } }
        }
    }

    // ---- account groups and account settings (groups_ui.rs; panel in groups_dialog.slint)
    if GroupsState.open: Dialog {
        dialog-width: 860px;
        GroupsPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: #2563eb; negative: Theme.negative;
            close() => { GroupsState.open = false; root.refocus(); }
        }
    }

    // ---- Lastschriften, Mandate, Rücklastschriften (mandates_ui.rs; panel in mandates_dialog.slint)
    if MandatesState.open: Dialog {
        dialog-width: 900px;
        MandatesPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: #2563eb; negative: Theme.negative;
            close() => { MandatesState.open = false; root.refocus(); }
        }
    }

    // ---- Import, Export, Sicherung, Einstellungen, Abrufprotokoll (settings_import_ui.rs; panel in settings_import_dialog.slint)
    if SettingsImportState.open: Dialog {
        dialog-width: 820px;
        SettingsImportPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: #2563eb; negative: Theme.negative;
            close() => { SettingsImportState.open = false; root.refocus(); }
        }
    }

    // ---- Sachwerte, Darlehen, Klassifizierung (assets_loans_ui.rs; panel in assets_loans_dialog.slint)
    if AssetsState.open: Dialog {
        dialog-width: 940px;
        AssetsLoansPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: #2563eb; negative: Theme.negative;
            close() => { AssetsState.open = false; root.refocus(); }
        }
    }

    // ---- tags / splits / budgets / templates dialogs
    if tags-open: Dialog {
        dialog-width: 600px;
        TagsPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: #2563eb; negative: Theme.negative;
            tags: root.tg-rows; palette: root.tg-palette; merge-names: root.tg-merge-names;
            booking-title: root.tg-booking-title; has-booking: root.tg-has-booking;
            status: root.tg-status; armed: root.tg-armed;
            selected <=> root.tg-selected; name <=> root.tg-name; color-choice <=> root.tg-color; merge-index <=> root.tg-merge;
            select(i) => { root.tag-select(i); }
            create(n, c) => { root.tag-create(n, c); }
            save(n, c) => { root.tag-save(n, c); }
            remove() => { root.tag-delete(); }
            move(d) => { root.tag-move(d); }
            merge(i) => { root.tag-merge(i); }
            assign() => { root.tag-assign(); }
            unassign() => { root.tag-unassign(); }
            clear-booking() => { root.tag-clear-booking(); }
            close() => { root.tags-open = false; root.refocus(); }
        }
    }
    if splits-open: Dialog {
        dialog-width: 640px;
        SplitsPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; negative: Theme.negative;
            booking-title: root.sp-title; booking-amount: root.sp-amount; remaining: root.sp-remaining;
            category-names: root.sp-category-names; rows: root.sp-rows; status: root.sp-status;
            amount-edited(i, t) => { root.split-amount(i, t); }
            note-edited(i, t) => { root.split-note(i, t); }
            category-picked(i, c) => { root.split-category(i, c); }
            add-row() => { root.split-add(); }
            remove-row(i) => { root.split-remove-row(i); }
            fill-rest(i) => { root.split-fill(i); }
            save() => { root.split-save(); }
            remove-split() => { root.split-clear(); }
            close() => { root.splits-open = false; root.refocus(); }
        }
    }
    if budgets-open: Dialog {
        dialog-width: 560px;
        BudgetsPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: #2563eb; negative: Theme.negative;
            month-title: root.bg-month; rows: root.bg-rows; category-names: root.bg-category-names; status: root.bg-status;
            category <=> root.bg-category; amount <=> root.bg-amount;
            pick(i) => { root.budget-pick(i); }
            set(c, a) => { root.budget-set(c, a); }
            clear(c) => { root.budget-clear(c); }
            close() => { root.budgets-open = false; root.refocus(); }
        }
    }
    if templates-open: Dialog {
        dialog-width: 600px;
        TemplatesPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: #2563eb; negative: Theme.negative;
            rows: root.tp-rows; status: root.tp-status; armed: root.tp-armed;
            selected <=> root.tp-selected; name <=> root.tp-name; recipient <=> root.tp-recipient;
            iban <=> root.tp-iban; bic <=> root.tp-bic; amount <=> root.tp-amount; purpose <=> root.tp-purpose;
            select(i) => { root.template-select(i); }
            new-template() => { root.template-new(); }
            save(a, b, c, d, e, f) => { root.template-save(a, b, c, d, e, f); }
            remove() => { root.template-delete(); }
            close() => { root.templates-open = false; root.refocus(); }
        }
    }

    // ---- recurring / planned / salary dialog
    if rc-open: Dialog {
        dialog-width: 640px;
        RecurringPanel {
            ink: Theme.text; muted: Theme.muted; line: Theme.border; accent: #2563eb; negative: Theme.negative;
            tab <=> root.rc-tab; status: root.rc-status; salary-cycle: root.rc-salary-cycle;
            has-booking: root.rc-has-booking; booking-title: root.rc-booking-title; series-text: root.rc-series-text;
            salary-state: root.rc-salary-state; can-salary: root.rc-can-salary; has-series: root.rc-has-series;
            interval-names: root.rc-interval-names; interval-index <=> root.rc-interval; custom-dates <=> root.rc-custom-dates;
            month-summary: root.rc-month-summary; month-rows: root.rc-month-rows; ignored-rows: root.rc-ignored-rows;
            planned-horizon <=> root.rc-planned-horizon; planned-summary: root.rc-planned-summary; planned-rows: root.rc-planned-rows;
            standing-rows: root.rc-standing-rows; limits-text: root.rc-limits;
            tab-changed(t) => { root.rc-tab-changed(t); }
            mark(i, d) => { root.rc-mark(i, d); }
            ignore() => { root.rc-ignore(); }
            reset() => { root.rc-reset(); }
            salary(c) => { root.rc-salary(c); }
            restore(i) => { root.rc-restore(i); }
            standing-select(i) => { root.rc-standing-select(i); }
            refresh() => { root.rc-refresh(); }
            close() => { root.rc-open = false; root.refocus(); }
        }
    }

    // ---- link a document to a booking
    if link-open: Dialog {
        dialog-width: 560px;
        Text { text: "Beleg mit Umsatz verknüpfen"; font-size: 18px; font-weight: 700; color: Theme.text; }
        LineEdit {
            placeholder-text: "Umsatz suchen (Gegenpartei, Verwendungszweck)";
            text <=> root.link-query;
            edited(t) => { root.link-search(t); }
        }
        Rectangle {
            height: 240px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            clip: true;
            if root.link-results.length == 0: Text { text: "Keine Umsätze"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
            ListView {
                for r[i] in root.link-results: TableLine {
                    data: r;
                    clickable: true;
                    clicked => { root.link-pick(i); }
                }
            }
        }
        if root.link-status != "": Text { text: root.link-status; color: Theme.negative; font-size: 12px; wrap: word-wrap; }
        HorizontalLayout { alignment: end; Button { text: "Abbrechen"; clicked => { root.link-open = false; root.refocus(); } } }
    }

    // ---- Tresore & Synchronisation
    if vaults-open: Dialog {
        dialog-width: 520px;
        Text { text: "Tresor wechseln / Neuer Tresor …"; font-size: 18px; font-weight: 700; color: Theme.text; }
        Text { text: "Aktiver Tresor: " + (root.vault-index >= 0 && root.vault-index < root.vault-names.length ? root.vault-names[root.vault-index] : "–"); font-size: 12px; color: Theme.muted; }
        HorizontalLayout {
            spacing: 8px;
            vcb := ComboBox { model: root.vault-names; current-index: root.vault-index; horizontal-stretch: 1; }
            Button { text: "Wechseln"; enabled: vcb.current-index != root.vault-index; clicked => { root.vault-switch(vcb.current-index); } }
            Button { text: "Löschen"; enabled: root.vault-names.length > 1 && vcb.current-index > 0; clicked => { root.vault-delete(vcb.current-index); } }
        }
        Text { text: "Jeder Tresor ist getrennt verschlüsselt (z. B. Haupttresor, Familie / Kinder, Geschäftlich). Das Löschen betrifft nur den gewählten Tresor, nicht die ganze App."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            LineEdit { placeholder-text: "Name des neuen Tresors"; text <=> root.vault-new-name; horizontal-stretch: 1; }
            Button { text: "Neuer Tresor"; primary: true; enabled: root.vault-new-name != ""; clicked => { root.vault-create(root.vault-new-name); } }
        }
        Rectangle { height: 1px; background: Theme.border; }
        Text { text: "Tresor-Synchronisation (iCloud Drive / Cloud-Ordner)"; font-size: 14px; font-weight: 700; color: Theme.text; }
        HorizontalLayout {
            spacing: 8px;
            Switch { text: "Synchronisation aktiv"; checked <=> root.vault-sync-enabled; toggled => { root.vault-sync-toggled(root.vault-sync-enabled); } }
        }
        LineEdit {
            placeholder-text: "Ordnerpfad, z. B. C:\\Users\\Name\\iCloudDrive\\GiroCrab";
            text <=> root.vault-sync-folder;
            enabled: root.vault-sync-enabled;
            edited(t) => { root.vault-sync-folder-changed(t); }
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Jetzt synchronisieren"; primary: true; enabled: root.vault-sync-enabled && root.vault-sync-folder != "" && !root.busy; clicked => { root.vault-sync-now(); } }
            Button { text: "Tresor-Schlüssel kopieren"; clicked => { root.vault-copy-key(); } }
        }
        if root.vault-status != "": Text { text: root.vault-status; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
        HorizontalLayout { alignment: end; Button { text: "Schließen"; primary: true; clicked => { root.vaults-open = false; root.refocus(); } } }
    }

    // ---- About
    if about-open: Dialog {
        dialog-width: 380px;
        Text { text: "GiroCrab"; font-size: 22px; font-weight: 700; color: Theme.text; }
        Text { text: "Version " + root.app-version; font-size: 13px; color: Theme.text; }
        Text { text: "Freie Software unter GPL-3.0-or-later. Der Tresor liegt verschlüsselt auf diesem Rechner."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        Text { text: "Tastenkürzel: Strg+F Suche · Strg+L Sperren · Strg+R / F5 Abrufen · Strg+I Importieren · Strg+N Überweisung · Esc Dialog schließen"; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
        HorizontalLayout { alignment: end; Button { text: "Schließen"; primary: true; clicked => { root.about-open = false; root.refocus(); } } }
    }
    }

    // ---- Startup splash: adaptive light/dark (system dark mode or 19:00-07:00), hero crab scales in, overlay fades out after ~950 ms.
    in-out property <bool> splash-visible: true;
    in-out property <bool> splash-shown: false;
    in property <bool> splash-dark: Theme.dark;
    in property <color> splash-bg: root.splash-dark ? #0F141C : #F8F9FB;
    in property <color> splash-fg: root.splash-dark ? #F9FAFB : #111827;
    in property <color> splash-sub: root.splash-dark ? #9CA3AF : #6B7280;
    splash-timer := Timer {
        interval: 950ms;
        running: root.splash-visible;
        triggered => { root.splash-visible = false; }
    }
    init => { root.splash-shown = true; }
    splash-fade := Rectangle {
        width: 100%;
        height: 100%;
        visible: root.splash-visible || self.opacity > 0.01;
        background: root.splash-bg;
        opacity: root.splash-visible ? 1.0 : 0.0;
        animate opacity { duration: 300ms; easing: ease-in-out; }
        TouchArea { enabled: root.splash-visible; }
        VerticalLayout {
            alignment: center;
            spacing: 14px;
            Rectangle {
                height: 148px;
                Rectangle {
                    width: 148px;
                    height: 148px;
                    border-radius: 32px;
                    background: root.splash-bg;
                    drop-shadow-blur: 24px;
                    drop-shadow-offset-y: 8px;
                    drop-shadow-color: #000000.with-alpha(root.splash-dark ? 0.55 : 0.18);
                    Image {
                        source: @image-url("../../docs/assets/app-icon.png");
                        width: root.splash-shown ? 148px : 121px; // 0.82 -> 1.0
                        height: self.width;
                        animate width { duration: 700ms; easing: ease-out-back; }
                        opacity: root.splash-shown ? 1.0 : 0.0;
                        animate opacity { duration: 500ms; easing: ease-out; }
                    }
                }
            }
            Text {
                text: "GiroCrab";
                color: root.splash-fg;
                font-size: 26px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: "Finanzen. Lokal. Verschlüsselt.";
                color: root.splash-sub;
                font-size: 13px;
                horizontal-alignment: center;
            }
        }
    }
}
