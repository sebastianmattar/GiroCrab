#!/bin/sh
# Runs every cheap CI lint (fmt, FinTS ID scan, notices, scripts/lint-*.sh, catalogs, Linux texts)
# in a few seconds: a red lint step otherwise fails the whole Rust job and skips the Swift job.
# Compile checks (clippy, swift build): scripts/verify-fast.sh without --lint-only.
# Aktivieren: git config core.hooksPath .githooks
scripts/verify-fast.sh --lint-only >/dev/null || {
  echo "pre-push: scripts/verify-fast.sh --lint-only ist rot (Ausgabe oben); beheben und erneut pushen." >&2
  exit 1
}
